# Скопируй в .env и подставь свои значения. Файл .env в git не попадёт (см. .gitignore).
# Токен от @BotFather. Никому его не показывай, в том числе в чатах с ИИ.
TG_TOKEN=
# ID чата, куда писать. Как узнать: напиши боту любое сообщение и открой
# https://api.telegram.org/bot<ТОКЕН>/getUpdates — там будет "chat":{"id":...}
TG_CHAT_ID=

# Ключ IsThereAnyDeal: нужен только для пометок 🔥 / 👍 / 🥱 «насколько хороша скидка».
# Бесплатный, без двухфакторки: https://isthereanydeal.com/apps/my/ → New App.
# Без ключа бот работает как обычно, просто без этих пометок.
ITAD_KEY=

# Регион цен и язык названий
STEAM_CC=UA
STEAM_LANG=english

# Порог скидки в процентах. 1 = присылать любую скидку.
MIN_DISCOUNT=1

# Время ежедневной отправки в режиме --loop (по Киеву)
TZ_NAME=Europe/Kyiv
SEND_HOUR=20
SEND_MINUTE=30

# Пути к файлам (по умолчанию рядом с проектом)
# GAMES_FILE=./games.json
# STATE_FILE=./state.json

# Максимум игр в сообщении, 0 = все
MAX_ITEMS=0
# Присылать в чат сообщение, если прогон упал (0 = не присылать)
NOTIFY_ERRORS=1
